[Unit]
Description=MateableCoin pool: stratum server (ports 4000 plain, 4001/4002/4003 TLS)
After=mtbc-pool-redis.service mtbc-node.service
Requires=mtbc-pool-redis.service

[Service]
Type=simple
WorkingDirectory=/root/claude/mtbc-nodejs-pool
ExecStart=/usr/local/bin/node /root/claude/mtbc-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
